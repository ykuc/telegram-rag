# APP
LOG_LEVEL=debug
# DATABASE
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telegram_rag
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/telegram_rag
VESPA_ENDPOINT=http://vespa:8080
PUBLIC_API_URL=http://localhost:8000
PUBLIC_VESPA_URL=http://localhost:19071
TELETHON_SESSION_PATH=/sessions/telethon.session

# Auth settings
APP_USER=admin
APP_USER_HASH_BCRYPT='$2b$12$qqivvFfe4CVsT/2c3x.5T.yvWZ7zWEYmCfI2h7ER0wi9QEnBqszxS'
SESSION_SECRET=d13968215a9d8679b371aae5b60106a8ec8f7def1feac0743e118abc2361f4ca
SESSION_TTL_HOURS=24
LOGIN_RATE_MAX_ATTEMPTS=5
LOGIN_RATE_WINDOW_SECONDS=900

# OpenAI-compatible API (OpenAI or Nebius Token Factory)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: set for Token Factory, e.g. https://api.tokenfactory.nebius.com/v1/
OPENAI_BASE_URL=
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=3072
# Nebius Token Factory (1536-dim via Matryoshka; must match Vespa vector_small):
# OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# EMBED_DIMENSIONS=1536
EMBED_BATCH_SIZE=64
EMBED_CONCURRENCY=4

# Search
SEARCH_DEFAULT_LIMIT=20

# Rerank (optional)
RERANK_ENABLED=true
VOYAGE_API_KEY=
RERANK_MODEL=rerank-2.5-lite
RERANK_CANDIDATE_LIMIT=40

# Chat
CHAT_DEFAULT_K=40
CHAT_MAX_CONTEXT_TOKENS=50000
CHAT_RATE_LIMIT_RPM=30
# Optional fallback when the client omits model_id
# CHAT_DEFAULT_MODEL_ID=
CHAT_SEARCH_DECISION_MODEL=gpt-4.1
CHAT_REFORMULATION_MODEL=gpt-4.1
# Nebius Token Factory (lightweight text->text; verify with GET /v1/models on your key):
# CHAT_SEARCH_DECISION_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# CHAT_REFORMULATION_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# google/gemma-3-27b-it also works; meta-llama/Meta-Llama-3.1-8B-Instruct is not in the current catalog

# Telegram: set TG_PHONE for SMS code login, or omit for QR on first run
TG_API_ID=your-telegram-api-id
TG_API_HASH=your-telegram-api-hash
# TG_PHONE=+1234567890
# TG_QR_LOGIN_TIMEOUT_SECS=120
# Pause between GetHistory RPC pages (Telegram rate limit; default 1.0)
# TELETHON_ITER_WAIT_SECS=1.0
# Extra pause after each yielded message (0 for bulk backfill; optional 0.05–0.1)
# TELETHON_INTER_MESSAGE_DELAY_SECS=0
# Daemon: comma-separated chats to index incrementally (default: all account chats)
INDEXER_CHATS=
# Days before DB max message_date to re-scan on daemon startup (default 1)
INDEXER_INCREMENTAL_DAYS=1
CHUNKING_VERSION=1
PREPROCESS_VERSION=1
REPLY_CONTEXT_TOKENS=1000
TARGET_CHUNK_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150

# Budget / backoff
DAILY_EMBED_BUDGET_USD=0
BACKOFF_BASE_MS=500
BACKOFF_MAX_MS=30000

# Testing stubs (set to true for testing)
OPENAI_STUB=false
TELETHON_STUB=false